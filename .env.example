# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). The anon key is safe
# to expose client-side — it's the public key, writes are still locked down
# by Row Level Security + the submit_wordezy_search_score RPC.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
